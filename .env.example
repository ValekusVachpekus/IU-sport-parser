# --- Telegram ---
# Token from @BotFather
BOT_TOKEN=123456:ABC-DEF...

# Comma-separated Telegram user IDs allowed to use the bot (you + friends).
# Get your id from @userinfobot. Leave empty to allow anyone (NOT recommended).
ALLOWED_TG_IDS=11111111,22222222

# --- Security ---
# Fernet key used to encrypt stored university passwords / tokens.
# Generate once with:  python -m app.crypto
FERNET_KEY=

# --- Storage ---
DB_URL=sqlite+aiosqlite:///data/sportparser.db

# --- Timezone of the sport site (used to interpret schedule times) ---
TZ=Europe/Moscow

# --- Innopolis SSO / Sport API (defaults are correct for production) ---
SPORT_API_BASE=https://sport.innopolis.university/api
SSO_BASE=https://sso.university.innopolis.ru/adfs
OAUTH_CLIENT_ID=7d0eb0b9-ad73-4942-be55-284facc99a95
OAUTH_REDIRECT_URI=https://sport.innopolis.university/oauth2/callback

# --- Behaviour tuning ---
# How long before open_at the scheduled burst starts (seconds).
BURST_LEAD_SECONDS=2
# Interval between burst attempts (ms) and max burst duration (s).
BURST_INTERVAL_MS=400
BURST_MAX_SECONDS=8
# Watch-mode polling interval (seconds) and jitter (seconds).
WATCH_INTERVAL_SECONDS=45
WATCH_JITTER_SECONDS=15
# How often the planner re-scans /calendar/trainings (minutes).
PLANNER_INTERVAL_MINUTES=180
